; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Riftwrought — 3D Production Project — FOUNDATION STAGE ACCEPTED and CLOSED (D-373) · IMPRINT STAGE DELIVERED and OPEN (D-375)"
config/description="The canonical 3D production project. Its first bounded FOUNDATION STAGE is ACCEPTED and CLOSED under D-373 (2026-09-17): fixed orthographic isometric camera, continuous character yaw, independent movement and aiming, click-to-move, baked navigation, per-prop collision, one small production test arena, one ordinary-enemy diagnostic loop, one clearly labelled diagnostic player attack, and the STOP/ALLOW action-movement commitment with recovery cancellation. Its SECOND stage, the GLOBAL IMPRINT SYSTEM PROTOTYPE (D-375), is DELIVERED and OPEN pending owner live review: Skill/Augment/Transform Imprints, an Imprint Library, Skill Configurations with four shared modifier slots and one Transform, a provisional 1-20 Mastered/Effective rank model, a Configuration Capacity budget, a separate Persistent Loadout, and three diagnostic builds. Completes no phase. Locks no value. Finalizes no roster, slot count, rank cap, Capacity value, XP curve, reservation value or balance."
config/version="0.2.0-d375"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

