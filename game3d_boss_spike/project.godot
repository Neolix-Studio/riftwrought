; Riftwrought — BOSS ANIMATION FEASIBILITY GATE (D-368, 2026-09-17)
; BOUNDED, ISOLATED FEASIBILITY GATE. NOT production. NOT a production pivot.
; NOT proof that all bosses are feasible. NOT final art. NOT final animation.
; NOT a bespoke boss animation pipeline. NOT the Crownless Warden. NOT P2.
; It completes no phase in the P0-P7 table and authorizes nothing.

config_version=5

[application]

config/name="Riftwrought Boss Animation Feasibility Gate (D-368) — NOT PRODUCTION"
config/description="Bounded, isolated Boss Animation Feasibility Gate authorized under D-368 (2026-09-17). Tests whether a stock Quaternius Bestiary rig plus the existing Universal Animation Library corpus can be composed into a boss encounter that reads as a boss rather than as an ordinary enemy. Completes no phase. Delivered OPEN pending owner live review."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[display]

; 1920x1080 is a COMPARISON OUTPUT for owner review, carried from the accepted
; D-366 spike. It is explicitly NOT a permanent product lock, and no 2D lock is
; promoted here.
window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

