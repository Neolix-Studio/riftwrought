; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Riftwrought — Huntress Bow-Retargeting and Prey Feasibility Spike — DELIVERED and OPEN (D-388)"
config/description="A bounded, isolated feasibility spike (D-388, 2026-09-19). It answers five questions on a live, rendered prototype: can the KayKit bow clips be retargeted convincingly onto the current 65-joint Huntress; can bow, hands, arrow and a procedural string form a readable draw/release; does the accepted STOP / recovery-cancellation behaviour still feel right with a real bow animation; is Prey understandable when switching between two targets; and does a labelled stand-in hound autonomously prefer the current Prey. NOT P2, NOT production, NOT final Huntress art, NOT VFX intake, NOT tuning, NOT a Skill. The KayKit Ranger is a DIAGNOSTIC NATIVE-RIG COMPARATOR ONLY. The hound is a procedural stand-in; no hound art is proven. Locks no value."
config/version="0.1.0-d388"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

