[gd_scene load_steps=5 format=3]

; Prototype Zero visual rig — Graveblade (registered KayKit Skeleton Warrior).
; Gate A proves the shared medium rig, scale coherence with the Knight, the
; medium-rig clips, and the handslot.r weapon attachment only.

[ext_resource type="PackedScene" path="res://assets/third_party/kaykit/skeleton/Skeleton_Warrior.glb" id="1_body"]
[ext_resource type="AnimationLibrary" path="res://assets/third_party/kaykit/animations/rig_medium_prototype_library.res" id="2_clips"]
[ext_resource type="PackedScene" path="res://assets/third_party/kaykit/skeleton/Skeleton_Blade.gltf" id="3_weapon"]
[ext_resource type="Script" path="res://scripts/actors/medium_rig_visual.gd" id="4_script"]

[node name="GravebladeRig" type="Node3D"]
script = ExtResource("4_script")
skeleton_path = NodePath("Skeleton_Warrior/Rig_Medium/Skeleton3D")
weapon_socket_bone = &"handslot.r"

[node name="Skeleton_Warrior" parent="." instance=ExtResource("1_body")]

[node name="AnimationPlayer" type="AnimationPlayer" parent="."]
root_node = NodePath("../Skeleton_Warrior")
libraries = {
&"": ExtResource("2_clips")
}

[node name="WeaponSocket" type="BoneAttachment3D" parent="."]
bone_name = "handslot.r"
bone_idx = 8
use_external_skeleton = true
external_skeleton = NodePath("../Skeleton_Warrior/Rig_Medium/Skeleton3D")

[node name="SkeletonBlade" parent="WeaponSocket" instance=ExtResource("3_weapon")]
