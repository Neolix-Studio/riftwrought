[ext_resource type="Script" path="res://scripts/ui/first_mvp_fallen_overlay.gd" id="7_fallen"]

; Flat, even, readable greybox lighting — byte-for-byte the accepted core loop's
; and the accepted D-222 review's environment. This review judges upgrade
; combinations and how they change play; a lighting direction that flattered or
; hid a shape would be answering a question nobody asked it. No fog, no sky, no
; post effect.
[sub_resource type="Environment" id="Environment_build_variety"]
background_mode = 1
background_color = Color(0.085, 0.092, 0.110, 1)
ambient_light_source = 2
ambient_light_color = Color(0.80, 0.83, 0.90, 1)
ambient_light_energy = 1.05
tonemap_mode = 0
fog_enabled = false

[node name="RogueliteBuildVarietyReview" type="Node3D"]
script = ExtResource("1_runtime")

