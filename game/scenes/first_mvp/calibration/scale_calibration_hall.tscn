[gd_scene load_steps=12 format=3]

; Riftwrought — First-MVP Gate 1A Scale Calibration Hall.
;
; A TEMPORARY DEVELOPER SCENE, authorized by D-195. It is not canonical, it is
; not a Bastion room, it is not the Severed Threshold, and it does not replace
; the persistent Prototype Zero main scene at scenes/app/prototype_app.tscn,
; which remains the project entrypoint and the regression authority.
;
; It contains: the hall architecture and its own collision, a navigation region
; baked from that collision, the locomotion-only calibration player, the accepted
; Prototype Zero camera rig, destination marker, and input-family tracker, the
; inert calibration fixtures, and the developer overlay.
;
; It contains NO combat, Quick Strike, target acquisition, enemy AI, damage,
; Life, Mana, loot, XP, Passive, inventory, story, Mara, Nexus, Riftmarked
; presentation, procedural generation, HUD, save, or settings, and it writes
; nothing to disk.
;
; Run it directly:
;   /Applications/Godot.app/Contents/MacOS/Godot --path game \
;     res://scenes/first_mvp/calibration/scale_calibration_hall.tscn

[ext_resource type="Script" path="res://scripts/first_mvp/calibration/scale_calibration_hall.gd" id="1_hall"]
[ext_resource type="Script" path="res://scripts/first_mvp/calibration/scale_calibration_geometry.gd" id="2_geometry"]
[ext_resource type="Resource" path="res://data/first_mvp/calibration/scale_calibration.tres" id="3_data"]
[ext_resource type="Script" path="res://scripts/camera/prototype_camera_rig.gd" id="4_camera"]
[ext_resource type="Script" path="res://scripts/prototype_zero/destination_marker.gd" id="5_marker"]
[ext_resource type="Script" path="res://scripts/input/input_family_tracker.gd" id="6_family"]
[ext_resource type="Script" path="res://scripts/first_mvp/calibration/calibration_fixtures.gd" id="7_fixtures"]
[ext_resource type="PackedScene" path="res://scenes/first_mvp/calibration/scale_calibration_overlay.tscn" id="8_overlay"]

[sub_resource type="ProceduralSkyMaterial" id="Sky_1"]
sky_top_color = Color(0.0705882, 0.0784314, 0.0980392, 1)
sky_horizon_color = Color(0.129412, 0.129412, 0.145098, 1)
ground_bottom_color = Color(0.0313726, 0.0352941, 0.0431373, 1)
ground_horizon_color = Color(0.129412, 0.129412, 0.145098, 1)

[sub_resource type="Sky" id="Sky_2"]
sky_material = SubResource("Sky_1")

[sub_resource type="Environment" id="Env_1"]
background_mode = 2
sky = SubResource("Sky_2")
ambient_light_source = 3
ambient_light_color = Color(0.454902, 0.501961, 0.6, 1)
ambient_light_energy = 0.85
tonemap_mode = 3
fog_enabled = true
fog_light_color = Color(0.0666667, 0.0705882, 0.0862745, 1)
fog_density = 0.004

[node name="ScaleCalibrationHall" type="Node3D"]
script = ExtResource("1_hall")

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env_1")

[node name="KeyLight" type="DirectionalLight3D" parent="."]
light_color = Color(1, 0.937255, 0.858824, 1)
light_energy = 1.0
shadow_enabled = true
shadow_opacity = 0.8

[node name="NavigationRegion3D" type="NavigationRegion3D" parent="."]

[node name="Geometry" type="Node3D" parent="NavigationRegion3D"]
script = ExtResource("2_geometry")
data = ExtResource("3_data")
grid_visible = false

[node name="Actors" type="Node3D" parent="."]

; Every fixture under here is mechanically inert and carries no collision object
; of any kind, so nothing in it can be hit, block movement, or enter the
; navigation bake.
[node name="Fixtures" type="Node3D" parent="."]
script = ExtResource("7_fixtures")
data = ExtResource("3_data")

[node name="DestinationMarker" type="Node3D" parent="."]
script = ExtResource("5_marker")

[node name="CameraRig" type="Node3D" parent="."]
script = ExtResource("4_camera")
yaw_degrees = 45.0
pitch_degrees = 55.0
fov_degrees = 45.0
distance_metres = 19.0

[node name="InputFamilyTracker" type="Node" parent="."]
script = ExtResource("6_family")

[node name="CanvasLayer" type="CanvasLayer" parent="."]

[node name="CalibrationOverlay" parent="CanvasLayer" instance=ExtResource("8_overlay")]
