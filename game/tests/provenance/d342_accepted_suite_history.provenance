	J2_VERIFICATION: "d5407c7c", J3_VERIFICATION: "1062c1db", J3_SMOKE: "689284cc", J4_VERIFICATION: "3deeb26a", J4_SMOKE: "cb520369",
}
const J8_MOVES: Dictionary = {
	J2_VERIFICATION: [

%3cfd6d4749e5e801664da0874fa7f571855f0c1c4d08a671cab93b6317b27503
=24
	],
	J3_VERIFICATION: [

