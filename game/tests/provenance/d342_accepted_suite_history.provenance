@text 22d96f445f1794f49c2f81659da2122b5e1148fad89f745c862bb9a6083d76ad
=4897
func _check_the_production_scope_is_exactly_the_slice() -> void:
	print("")
	print("--- 1. Exactly one production file moved — Gate 1D's slice — and it is the pre-J3 file plus one comment and two lines")
	var source: String = _before_j4(_before_j5(_before_j9(_before_j10(FileAccess.get_file_as_string(SLICE_SCRIPT)))))
	var digest: String = source.sha256_text()
	var rebuilt: String = source.replace(J3_ADDED_COMMENT, "").replace(J3_CANCELLATION, "")
	_expect(FileAccess.get_sha256(SLICE_SCRIPT).begins_with(J10_SLICE_PREFIX)
			and _before_j10(FileAccess.get_file_as_string(SLICE_SCRIPT)).sha256_text().begins_with(J9_SLICE_PREFIX)
			and _before_j9(_before_j10(FileAccess.get_file_as_string(SLICE_SCRIPT))).sha256_text().begins_with(J5_SLICE_PREFIX)
			and _before_j5(_before_j9(_before_j10(FileAccess.get_file_as_string(SLICE_SCRIPT)))).sha256_text().begins_with(J4_SLICE_PREFIX) and digest.begins_with(J3_PREFIX)
			and source.count(J3_ADDED_COMMENT) == 1 and source.count(J3_CANCELLATION) == 1
			and rebuilt.sha256_text() == PRE_J3_SHA256,
		"the slice hashes %s; the comment occurs %d time(s), the cancellation %d; the reconstruction hashes %s"
			% [digest.left(8), source.count(J3_ADDED_COMMENT), source.count(J3_CANCELLATION), rebuilt.sha256_text().left(8)])
	var moved: PackedStringArray = PackedStringArray()
	for row: Array in UNCHANGED_HASHES:
		var held: String = FileAccess.get_sha256(String(row[0]))
		if not held.begins_with(String(row[1])):
			moved.append("%s %s" % [String(row[0]).get_file(), held.left(8)])
	_expect(moved.is_empty() and UNCHANGED_HASHES.size() == 37, "moved: %s" % ", ".join(moved))
	var j1: String = _before_j4(_before_j5(_before_j9(_before_j10(FileAccess.get_file_as_string(J1_VERIFICATION)))))
	var j2: String = _before_j4(_before_j5(_before_j6(_before_j7(_before_j8(_before_j9(_before_j10(FileAccess.get_file_as_string(J2_VERIFICATION))))))))
	var j1_back: String = j1.replace(_slice_row_new(), SLICE_ROW_OLD).replace(J1_CLAUSE, "")
	var j2_back: String = j2.replace(_slice_row_new(), SLICE_ROW_OLD).replace(J2_CLAUSE, "")
	_expect(FileAccess.get_sha256(J1_VERIFICATION).begins_with(J10_J1_PREFIX)
			and _before_j10(FileAccess.get_file_as_string(J1_VERIFICATION)).sha256_text().begins_with(J9_J1_PREFIX)
			and _before_j9(_before_j10(FileAccess.get_file_as_string(J1_VERIFICATION))).sha256_text().begins_with(J5_J1_PREFIX)
			and _before_j5(_before_j9(_before_j10(FileAccess.get_file_as_string(J1_VERIFICATION)))).sha256_text().begins_with(J4_J1_PREFIX) and j1.sha256_text().begins_with(J1_PREFIX)
			and j1.count(_slice_row_new()) == 1 and j1.count(J1_CLAUSE) == 1 and j1_back.sha256_text() == J1_PRE_SHA256
			and FileAccess.get_sha256(J2_VERIFICATION).begins_with(J10_J2_PREFIX)
			and _before_j10(FileAccess.get_file_as_string(J2_VERIFICATION)).sha256_text().begins_with(J9_J2_PREFIX)
			and _before_j9(_before_j10(FileAccess.get_file_as_string(J2_VERIFICATION))).sha256_text().begins_with(J8_J2_PREFIX)
			and _before_j8(_before_j9(_before_j10(FileAccess.get_file_as_string(J2_VERIFICATION)))).sha256_text().begins_with(J7_J2_PREFIX)
			and _before_j7(_before_j8(_before_j9(_before_j10(FileAccess.get_file_as_string(J2_VERIFICATION))))).sha256_text().begins_with(J6_J2_PREFIX)
			and _before_j6(_before_j7(_before_j8(_before_j9(_before_j10(FileAccess.get_file_as_string(J2_VERIFICATION)))))).sha256_text().begins_with(J5_J2_PREFIX)
			and _before_j5(_before_j6(_before_j7(_before_j8(_before_j9(_before_j10(FileAccess.get_file_as_string(J2_VERIFICATION))))))).sha256_text().begins_with(J4_J2_PREFIX) and j2.sha256_text().begins_with(J2_PREFIX)
			and j2.count(_slice_row_new()) == 1
			and j2.count(J2_CLAUSE) == 1 and j2_back.sha256_text() == J2_PRE_SHA256,
		"J1 %s rebuilds to %s; J2 %s rebuilds to %s" % [FileAccess.get_sha256(J1_VERIFICATION).left(8), j1_back.sha256_text().left(8),
			FileAccess.get_sha256(J2_VERIFICATION).left(8), j2_back.sha256_text().left(8)])
	print("  the slice is at its J5 hash %s; with J5's one line removed, at its J4 hash %s; with J4's 3 comments and 3 guards removed, at its J3 hash %s; with J3's %d comment lines and its 2 cancellation lines removed it is, byte for byte, the pre-J3 file %s — once J9's two changes (D-338) are put back, and J10's clearing line (D-340) before them"
		% [J5_SLICE_PREFIX, J4_SLICE_PREFIX, J3_PREFIX, J3_ADDED_COMMENT.count("\n"), PRE_J3_SHA256.left(8)])
	print("  %d files J3 stands beside hold the hashes they held before the first J3 edit, but for the combat HUD, which J6 moved (D-332), and Broken Watch's layout, which J10 moved (D-340)" % UNCHANGED_HASHES.size())
	print("  J1's and J2's verifications moved only their slice row, with its comment and one clause in their print, under J3, again under J4 and again under J5: put back, they are byte for byte %s and %s"
		% [J1_PRE_SHA256.left(8), J2_PRE_SHA256.left(8)])
	_done("the_production_scope_is_exactly_the_slice")
@end
@text 2309128755b1592442751a8bce58c2ff896b5783007567fe93d7acebba3ec133
=902
# First-MVP UI J8 (D-336) replaced one line of its own with eight; they are put back first, leaving the HUD J7 left.
cat > "$work/j8_lines.txt" <<'LINES'
	# First-MVP UI J8 (decision D-336): the column is anchored by its bottom edge,
	# 24 px above the viewport's, and grows upward to its own height. A top edge
	# 80 px above the bottom left the 94 px column's last 14 px below the window.
	resources.offset_left = 24.0
	resources.offset_top = -24.0
	resources.offset_right = 24.0
	resources.offset_bottom = -24.0
	resources.grow_vertical = Control.GROW_DIRECTION_BEGIN
LINES
awk -v old=$'\tresources.position = Vector2(24, -80)' 'NR == FNR { j8[$0] = 1; next } ($0 in j8) { if (!done) print old; done = 1; next } { print }' \
	"$work/j8_lines.txt" "$PROJECT_DIR/$HUD" > "$work/hud_j7.txt"
# J7's eight inserted lines, removed from the file on disk: what is left must be the D-333 HUD, byte for byte.

@end
