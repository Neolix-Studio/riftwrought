@text 93340eb2f9bfb2c1c1b85611b975e53c7369ccdc9722b8c0ad108ebc75a105e0
=4320
func _check_the_production_scope_is_exactly_the_slice() -> void:
	print("")
	print("--- 1. Exactly one production file moved — Gate 1D's slice — and it is the pre-J3 file plus one comment and two lines")
	var source: String = _before_j4(_before_j5(_before_j9(FileAccess.get_file_as_string(SLICE_SCRIPT))))
	var digest: String = source.sha256_text()
	var rebuilt: String = source.replace(J3_ADDED_COMMENT, "").replace(J3_CANCELLATION, "")
	_expect(FileAccess.get_sha256(SLICE_SCRIPT).begins_with(J9_SLICE_PREFIX)
			and _before_j9(FileAccess.get_file_as_string(SLICE_SCRIPT)).sha256_text().begins_with(J5_SLICE_PREFIX)
			and _before_j5(_before_j9(FileAccess.get_file_as_string(SLICE_SCRIPT))).sha256_text().begins_with(J4_SLICE_PREFIX) and digest.begins_with(J3_PREFIX)
			and source.count(J3_ADDED_COMMENT) == 1 and source.count(J3_CANCELLATION) == 1
			and rebuilt.sha256_text() == PRE_J3_SHA256,
		"the slice hashes %s; the comment occurs %d time(s), the cancellation %d; the reconstruction hashes %s"
			% [digest.left(8), source.count(J3_ADDED_COMMENT), source.count(J3_CANCELLATION), rebuilt.sha256_text().left(8)])
	var moved: PackedStringArray = PackedStringArray()
	for row: Array in UNCHANGED_HASHES:
		var held: String = FileAccess.get_sha256(String(row[0]))
		if not held.begins_with(String(row[1])):
			moved.append("%s %s" % [String(row[0]).get_file(), held.left(8)])
	_expect(moved.is_empty() and UNCHANGED_HASHES.size() == 37, "moved: %s" % ", ".join(moved))
	var j1: String = _before_j4(_before_j5(_before_j9(FileAccess.get_file_as_string(J1_VERIFICATION))))
	var j2: String = _before_j4(_before_j5(_before_j6(_before_j7(_before_j8(_before_j9(FileAccess.get_file_as_string(J2_VERIFICATION)))))))
	var j1_back: String = j1.replace(_slice_row_new(), SLICE_ROW_OLD).replace(J1_CLAUSE, "")
	var j2_back: String = j2.replace(_slice_row_new(), SLICE_ROW_OLD).replace(J2_CLAUSE, "")
	_expect(FileAccess.get_sha256(J1_VERIFICATION).begins_with(J9_J1_PREFIX)
			and _before_j9(FileAccess.get_file_as_string(J1_VERIFICATION)).sha256_text().begins_with(J5_J1_PREFIX)
			and _before_j5(_before_j9(FileAccess.get_file_as_string(J1_VERIFICATION))).sha256_text().begins_with(J4_J1_PREFIX) and j1.sha256_text().begins_with(J1_PREFIX)
			and j1.count(_slice_row_new()) == 1 and j1.count(J1_CLAUSE) == 1 and j1_back.sha256_text() == J1_PRE_SHA256
			and FileAccess.get_sha256(J2_VERIFICATION).begins_with(J9_J2_PREFIX)
			and _before_j9(FileAccess.get_file_as_string(J2_VERIFICATION)).sha256_text().begins_with(J8_J2_PREFIX)
			and _before_j8(_before_j9(FileAccess.get_file_as_string(J2_VERIFICATION))).sha256_text().begins_with(J7_J2_PREFIX)
			and _before_j7(_before_j8(_before_j9(FileAccess.get_file_as_string(J2_VERIFICATION)))).sha256_text().begins_with(J6_J2_PREFIX)
			and _before_j6(_before_j7(_before_j8(_before_j9(FileAccess.get_file_as_string(J2_VERIFICATION))))).sha256_text().begins_with(J5_J2_PREFIX)
			and _before_j5(_before_j6(_before_j7(_before_j8(_before_j9(FileAccess.get_file_as_string(J2_VERIFICATION)))))).sha256_text().begins_with(J4_J2_PREFIX) and j2.sha256_text().begins_with(J2_PREFIX)
			and j2.count(_slice_row_new()) == 1
			and j2.count(J2_CLAUSE) == 1 and j2_back.sha256_text() == J2_PRE_SHA256,
		"J1 %s rebuilds to %s; J2 %s rebuilds to %s" % [FileAccess.get_sha256(J1_VERIFICATION).left(8), j1_back.sha256_text().left(8),
			FileAccess.get_sha256(J2_VERIFICATION).left(8), j2_back.sha256_text().left(8)])
	print("  the slice is at its J5 hash %s; with J5's one line removed, at its J4 hash %s; with J4's 3 comments and 3 guards removed, at its J3 hash %s; with J3's %d comment lines and its 2 cancellation lines removed it is, byte for byte, the pre-J3 file %s — once J9's two changes (D-338) are put back"
		% [J5_SLICE_PREFIX, J4_SLICE_PREFIX, J3_PREFIX, J3_ADDED_COMMENT.count("\n"), PRE_J3_SHA256.left(8)])
	print("  %d files J3 stands beside hold the hashes they held before the first J3 edit, but for the combat HUD, which J6 moved (D-332)" % UNCHANGED_HASHES.size())
	print("  J1's and J2's verifications moved only their slice row, with its comment and one clause in their print, under J3, again under J4 and again under J5: put back, they are byte for byte %s and %s"
		% [J1_PRE_SHA256.left(8), J2_PRE_SHA256.left(8)])
	_done("the_production_scope_is_exactly_the_slice")
@end
