## Puts a file J6 moved back to where J5 left it (First-MVP UI J6, D-332).
func _before_j6(path: String, text: String) -> String:
	for pair: Array in J6_MOVES.get(path, []):
		text = text.replace(String(pair[0]), String(pair[1]))
	return text

@end
