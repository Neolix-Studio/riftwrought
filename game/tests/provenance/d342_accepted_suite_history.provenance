=17
	],
	J3_SMOKE: [

%3ac248809645192bb948960935d03919041698fc4db7f88ca5f870e21a321cc6
=24
	],
	J4_VERIFICATION: [

%1b66d63242bdd82fa624b7795247d40b5d49999ac005af40d8c6f9e110d8b4fd
=17
	],
	J4_SMOKE: [

%604de133e29e7eef2e1abf4ea9985e367acebef9edffb68acffd93037a9cd1cd
=95
	],
}

## Everything J5 stands beside, at the SHA-256 prefix each held before the first J5 edit
