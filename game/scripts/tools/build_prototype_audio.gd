extends SceneTree
## Riftwrought — Prototype Zero Gate F: the project-authored audio cue generator
## (specification §19, decision D-189).
##
## THIS SCRIPT IS THE ONLY SOURCE OF EVERY SOUND IN THE PROJECT.
##
## No audio file was downloaded, purchased, extracted from an archive, or
## imported. Every cue is synthesised here from first principles — filtered
## noise beds, inharmonic partial clusters, granular fracture grains, swept
## state-variable band-passes, reversed onsets, pitch strain, and shaped
## envelopes — and written as a native Godot `AudioStreamWAV` resource. There is
## no `.wav`, `.ogg`, or `.mp3` anywhere under `assets/prototype/audio`, and the
## Gate F suite asserts that by walking the directory.
##
## Writing `.res` rather than `.wav` is the same choice the project already made
## for the two generated animation clips: the file is a Godot resource with no
## import step, it is regenerated by a script that lives in the repository, and
## it can never be mistaken for something that arrived from outside.
##
## The cue table is NOT here. It is `scripts/audio/prototype_cue_catalogue.gd`,
## shared with the runtime audio director, so the sound that is synthesised and
## the sound that is routed can never be two different lists.
##
## Regenerate with:
##   godot --headless --path game --script res://scripts/tools/build_prototype_audio.gd
##
## Add `-- --peaks` for the per-cue measured peak and RMS table.
##
## Determinism: every variant seeds its own RandomNumberGenerator from the family
## name and the variant index, so regenerating produces byte-identical files.
## "Variation" between takes is therefore AUTHORED variation — different filter
## centres, decay times, and grain placements per take — not one take played
## through a random pitch shifter.

const RATE: float = float(PrototypeCueCatalogue.MIX_RATE)
const TAU_2PI: float = 6.283185307179586

var _peak_table: bool = false
## Optional directory for RIFF `.wav` AUDITION copies. They are written OUTSIDE
## the Godot project — into the evidence folder or a scratch directory — so the
## project owner can listen to every cue without launching the game. They are
## not project assets, nothing loads them, and no `.wav` is ever written under
## `assets/prototype/audio`.
var _wav_directory: String = ""
var _rows: Array[Dictionary] = []


func _initialize() -> void:
	var arguments: PackedStringArray = OS.get_cmdline_user_args()
	_peak_table = arguments.has("--peaks")
	for index: int in arguments.size():
		if arguments[index] == "--wav" and index + 1 < arguments.size():
			_wav_directory = arguments[index + 1]
			DirAccess.make_dir_recursive_absolute(_wav_directory)

	print("")
	print("=== Prototype Zero authored audio ===")
	print("Every cue below is synthesised by this script. Nothing was downloaded.")
	print("")

	var directory: String = PrototypeCueCatalogue.CUE_DIRECTORY
	if not DirAccess.dir_exists_absolute(ProjectSettings.globalize_path(directory)):
		DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(directory))

	var failures: int = 0
	var written: int = 0
	var bytes: int = 0

	for family: String in PrototypeCueCatalogue.family_names():
		var entry: Dictionary = PrototypeCueCatalogue.FAMILIES[family] as Dictionary
		var seconds: float = float(entry["seconds"])
		var variants: int = int(entry["variants"])
		for index: int in variants:
			var samples: PackedFloat32Array = _synthesize(family, index, seconds)
			if samples.is_empty():
				printerr("FAIL: no synthesis recipe for cue family '%s'" % family)
				failures += 1
				continue
			_fade_edges(samples, 0.0015, 0.004)
			var measured: Dictionary = _measure(samples)
			var stream: AudioStreamWAV = _to_stream(samples)
			var path: String = PrototypeCueCatalogue.variant_path(family, index)
			var error: int = ResourceSaver.save(stream, path)
			if error != OK:
				printerr("FAIL: could not write %s (error %d)" % [path, error])
				failures += 1
				continue
			written += 1
			bytes += stream.data.size()
			if _wav_directory != "":
				_write_wav_audition(stream, "%s/%s_%d.wav" % [_wav_directory, family, index + 1])
			_rows.append({
				"family": family, "variant": index + 1, "path": path,
				"seconds": float(samples.size()) / RATE,
				"peak": float(measured["peak"]), "rms": float(measured["rms"]),
				"crest_db": float(measured["crest_db"]),
			})

	_print_summary(written, bytes)
	if _peak_table:
		_print_peaks()

	if failures == 0:
		failures += _write_derivation_note()

	print("")
	if failures == 0:
		print("PROTOTYPE AUDIO BUILD: PASS (%d cue variants across %d families, %.1f KiB)" % [
			written, PrototypeCueCatalogue.FAMILIES.size(), float(bytes) / 1024.0,
		])
		quit(0)
		return
	printerr("PROTOTYPE AUDIO BUILD: %d FAILURE(S)" % failures)
	quit(1)


# =============================================================================
#  Per-family synthesis
#
#  Each recipe below is the executable form of the `recipe` text in the
#  catalogue. If one changes, the other is wrong, and the generator writes the
#  catalogue's text into the source note so the two are published together.
# =============================================================================

func _synthesize(family: String, variant: int, seconds: float) -> PackedFloat32Array:
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = hash("riftwrought/%s/%d" % [family, variant])
	match family:
		"footstep":
			return _footstep(rng, variant, seconds)
		"quick_strike_commit":
			return _quick_strike_commit(rng, variant, seconds)
		"quick_strike_release":
			return _quick_strike_release(rng, variant, seconds)
		"impact_bone_ordinary":
			return _bone_impact(rng, variant, seconds, false)
		"impact_bone_improved":
			return _bone_impact(rng, variant, seconds, true)
		"graveblade_anticipation":
			return _graveblade_anticipation(rng, variant, seconds)
		"graveblade_release":
			return _graveblade_release(rng, variant, seconds)
		"graveblade_death":
			return _graveblade_death(rng, variant, seconds)
		"player_damage":
			return _player_damage(rng, variant, seconds)
		"sword_drop":
			return _sword_drop(rng, variant, seconds)
		"reward_experience":
			return _reward_experience(rng, seconds)
		"comparison_open":
			return _stone_slab(rng, seconds, 300.0, 0.040, 0.150)
		"equip":
			return _equip(rng, seconds)
		"passive_confirm":
			return _passive_confirm(rng, seconds)
		"menu_move":
			return _menu_move(rng, variant, seconds)
		"menu_confirm":
			return _menu_confirm(rng, variant, seconds)
		"menu_open":
			return _stone_slab(rng, seconds, 340.0, 0.030, 0.120)
		"menu_close":
			return _menu_close(rng, seconds)
		"invalid_action":
			return _invalid_action(rng, seconds)
		"fallen":
			return _fallen(rng, seconds)
	return PackedFloat32Array()


## Boot on dressed stone: low thud + dust grit + a leather creak.
func _footstep(rng: RandomNumberGenerator, variant: int, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	# Per-take authored variation, not a pitch shift of one take.
	var thud_cutoff: float = [170.0, 195.0, 210.0, 230.0][variant % 4]
	var thud_decay: float = [0.022, 0.026, 0.030, 0.024][variant % 4]
	var grit_cutoff: float = [2100.0, 2600.0, 3000.0, 3400.0][variant % 4]
	var grit_decay: float = [0.055, 0.068, 0.075, 0.060][variant % 4]

	var thud: PackedFloat32Array = _noise(rng, 0.09)
	_lowpass(thud, thud_cutoff, 2)
	_exp_decay(thud, thud_decay)
	_peak_to(thud, 1.0)
	_add(out, thud, 1.0, 0.0)

	var grit: PackedFloat32Array = _noise(rng, 0.12)
	_highpass(grit, grit_cutoff)
	_exp_decay(grit, grit_decay)
	_peak_to(grit, 1.0)
	_add(out, grit, _db(-16.0), 0.002)

	var creak: PackedFloat32Array = _noise(rng, 0.10)
	_bandpass(creak, 780.0 + 100.0 * float(variant % 4), 4.0, 2)
	_exp_decay(creak, 0.045)
	_peak_to(creak, 1.0)
	_add(out, creak, _db(-22.0), 0.006)

	_normalize(out, 0.92)
	return out


## Reversed onset: the swing being decided, then one iron tick as the wrist sets.
func _quick_strike_commit(rng: RandomNumberGenerator, variant: int, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var centre: float = 300.0 + 120.0 * float(variant)

	var swell: PackedFloat32Array = _noise(rng, seconds * 0.86)
	_bandpass(swell, centre, 3.2, 2)
	_exp_decay(swell, 0.075)
	_reverse(swell)
	_peak_to(swell, 1.0)
	_add(out, swell, 1.0, 0.0)

	var tick: PackedFloat32Array = _partials(0.030, [2310.0, 3010.0] as Array[float], [1.0, 0.55] as Array[float], 0.010, 0.0)
	_add(out, tick, _db(-13.0), seconds - 0.032)

	_normalize(out, 0.88)
	return out


## Blade through air: a swept band-pass doppler with a thin metallic edge.
func _quick_strike_release(rng: RandomNumberGenerator, variant: int, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var top: float = [1650.0, 1780.0, 1540.0][variant % 3]
	var bottom: float = [430.0, 400.0, 470.0][variant % 3]

	var air: PackedFloat32Array = _noise(rng, seconds)
	_bandpass_swept(air, top, bottom, 2.4, 2)
	_env_attack_decay(air, 0.006, 0.190, 1.6)
	_peak_to(air, 1.0)
	_add(out, air, 1.0, 0.0)

	var edge_amps: Array[float] = [1.0, 0.62]
	var edge: PackedFloat32Array = _partials(0.060, [2410.0, 3130.0], edge_amps, 0.038, 0.02)
	_add(out, edge, _db(-15.0), 0.010)

	_normalize(out, 0.94)
	return out


## Sword on bone. `heavier` is the improved 150-damage Hit: the SAME four layers
## with more mass, and deliberately nothing that would read as elemental.
func _bone_impact(
	rng: RandomNumberGenerator, variant: int, seconds: float, heavier: bool
) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)

	# 1. Transient.
	var transient: PackedFloat32Array = _noise(rng, 0.020)
	_highpass(transient, 1500.0)
	_exp_decay(transient, 0.003)
	_peak_to(transient, 1.0)
	_add(out, transient, 1.0, 0.0)

	# 2. Inharmonic bone body. No partial is a whole multiple of another.
	var detune: float = 1.0 + 0.018 * float(variant - 1)
	var body_freqs: Array[float] = [318.0 * detune, 511.0 * detune, 779.0 * detune]
	if heavier:
		# A whole tone lower, which reads as a heavier blade rather than as a
		# different material. The inharmonic RATIOS are identical.
		body_freqs = [283.0 * detune, 455.0 * detune, 694.0 * detune]
	var body_amps: Array[float] = [1.0, 0.62, 0.38]
	var body_decay: float = 0.117 if heavier else 0.090
	var body: PackedFloat32Array = _partials(
		body_decay * 3.0, body_freqs, body_amps, body_decay, 0.04
	)
	_add(out, body, _db(-2.5), 0.001)

	# 3. Granular fracture. One more grain when the sword is heavier.
	var grains: int = 4 if heavier else 3
	for grain: int in grains:
		var at: float = 0.006 + 0.008 * float(grain) + rng.randf_range(-0.002, 0.002)
		var grain_buffer: PackedFloat32Array = _noise(rng, 0.030)
		_bandpass(grain_buffer, rng.randf_range(2600.0, 3000.0), 5.0, 2)
		_exp_decay(grain_buffer, 0.008)
		_peak_to(grain_buffer, 1.0)
		_add(out, grain_buffer, _db(-9.0 - 1.5 * float(grain)), at)

	# 4. Dust and stone.
	var thump: PackedFloat32Array = _partials(0.20, [90.0] as Array[float], [1.0] as Array[float], 0.070, 0.03)
	_add(out, thump, _db(-5.0), 0.002)
	var dust_length: float = 0.252 if heavier else 0.180
	var dust: PackedFloat32Array = _noise(rng, dust_length)
	_lowpass(dust, 620.0, 2)
	_exp_decay(dust, dust_length * 0.42)
	_peak_to(dust, 1.0)
	_add(out, dust, _db(-17.0), 0.010)

	# The only thing the heavier Hit adds that the ordinary one does not have:
	# WEIGHT. It is below the ordinary Hit's lowest layer, not above it.
	if heavier:
		var weight: PackedFloat32Array = _partials(0.30, [60.0] as Array[float], [1.0] as Array[float], 0.140, 0.02)
		_add(out, weight, _db(-6.5), 0.000)

	_normalize(out, 0.97)
	return out


## The telegraph: a long hollow reversed onset with pitch strain under it, which
## stops abruptly on the last sample. The silence after it is part of the cue.
func _graveblade_anticipation(
	rng: RandomNumberGenerator, variant: int, seconds: float
) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var hollow: PackedFloat32Array = _noise(rng, seconds)
	_bandpass(hollow, 210.0 + 30.0 * float(variant), 8.0, 2)
	_exp_decay(hollow, 0.160)
	_reverse(hollow)
	_peak_to(hollow, 1.0)
	_add(out, hollow, 1.0, 0.0)

	# A dry scrape of bone on stone as the weight shifts, so the telegraph has a
	# body the player can localise and is not only a low swell.
	var scrape: PackedFloat32Array = _noise(rng, seconds * 0.7)
	_bandpass_swept(scrape, 620.0, 1150.0, 4.0, 2)
	_env_attack_decay(scrape, seconds * 0.55, seconds * 0.15, 1.2)
	_peak_to(scrape, 1.0)
	_add(out, scrape, _db(-13.0), seconds * 0.20)

	var strain: PackedFloat32Array = _swept_sine(seconds, 68.0, 96.0, 2.2)
	_env_attack_decay(strain, seconds * 0.80, seconds * 0.20, 1.0)
	_add(out, strain, _db(-10.0), 0.0)

	_normalize(out, 0.85)
	return out


## The enemy's swing: heavier, lower, and slower to start than the player's, with
## a bone-handle rattle in place of the player's metallic edge.
func _graveblade_release(
	rng: RandomNumberGenerator, variant: int, seconds: float
) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var air: PackedFloat32Array = _noise(rng, seconds)
	_bandpass_swept(air, 940.0 + 60.0 * float(variant), 260.0, 2.0, 2)
	_env_attack_decay(air, 0.010, 0.210, 1.5)
	_peak_to(air, 1.0)
	_add(out, air, 1.0, 0.0)

	for grain: int in 4:
		var rattle: PackedFloat32Array = _noise(rng, 0.024)
		_bandpass(rattle, rng.randf_range(1100.0, 1900.0), 6.0, 2)
		_exp_decay(rattle, 0.007)
		_peak_to(rattle, 1.0)
		_add(out, rattle, _db(-15.0), 0.020 + 0.026 * float(grain))

	_normalize(out, 0.93)
	return out


## Bone collapse: eleven falling fracture grains, one stone settle, a dust tail
## that outlives both, and a deliberately near-silent last 180 ms.
func _graveblade_death(
	rng: RandomNumberGenerator, variant: int, seconds: float
) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	for grain: int in 11:
		var progress: float = float(grain) / 10.0
		var at: float = progress * 0.520 + rng.randf_range(-0.012, 0.012) + 0.004 * float(variant)
		var clatter: PackedFloat32Array = _noise(rng, 0.045)
		_bandpass(clatter, rng.randf_range(1200.0, 3500.0), 7.0, 2)
		_exp_decay(clatter, rng.randf_range(0.008, 0.016))
		_peak_to(clatter, 1.0)
		_add(out, clatter, _db(-3.0 - 11.0 * progress), maxf(at, 0.0))

	var settle: PackedFloat32Array = _partials(0.36, [78.0] as Array[float], [1.0] as Array[float], 0.130, 0.05)
	_add(out, settle, _db(-4.0), 0.260)

	var dust: PackedFloat32Array = _noise(rng, 0.62)
	_lowpass(dust, 520.0, 2)
	_exp_decay(dust, 0.180)
	_peak_to(dust, 1.0)
	_add(out, dust, _db(-16.0), 0.040)

	_normalize(out, 0.95)
	return out


## Damage into the player: blunt, close, and dull. No fracture grains — the
## player is not bone, and that is the whole reason the two are never confused.
func _player_damage(
	rng: RandomNumberGenerator, variant: int, seconds: float
) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var thud: PackedFloat32Array = _noise(rng, 0.16)
	_lowpass(thud, 380.0 + 40.0 * float(variant), 2)
	_env_attack_decay(thud, 0.002, 0.075, 1.4)
	_peak_to(thud, 1.0)
	_add(out, thud, 1.0, 0.0)

	var strain_amps: Array[float] = [1.0]
	var strain_freqs: Array[float] = [138.0 + 6.0 * float(variant)]
	var strain: PackedFloat32Array = _partials(0.28, strain_freqs, strain_amps, 0.085, 0.09)
	_add(out, strain, _db(-5.0), 0.000)

	# Mail and leather. Loud enough to place the Hit ON the player rather than
	# somewhere in the low end, and the one layer that tells this cue apart from
	# an impact on bone.
	var mail: PackedFloat32Array = _noise(rng, 0.18)
	_bandpass(mail, 1900.0, 3.5, 2)
	_exp_decay(mail, 0.055)
	_peak_to(mail, 1.0)
	_add(out, mail, _db(-11.0), 0.004)

	_normalize(out, 0.96)
	return out


## Iron landing on stone. Metal is closer to harmonic than bone, which is what
## makes the drop and the Hit recognisably different objects.
func _sword_drop(rng: RandomNumberGenerator, variant: int, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var transient: PackedFloat32Array = _noise(rng, 0.014)
	_highpass(transient, 2200.0)
	_exp_decay(transient, 0.002)
	_peak_to(transient, 1.0)
	_add(out, transient, _db(-4.0), 0.0)

	var detune: float = 1.0 + 0.02 * float(variant)
	var metal: PackedFloat32Array = _partials(
		0.50, [1180.0 * detune, 1790.0 * detune, 2630.0 * detune] as Array[float],
		[1.0, 0.70, 0.40] as Array[float], 0.260, 0.01
	)
	_add(out, metal, _db(-4.0), 0.000)

	var stone: PackedFloat32Array = _partials(0.22, [96.0] as Array[float], [1.0] as Array[float], 0.075, 0.04)
	_add(out, stone, _db(-3.0), 0.001)

	var settle: PackedFloat32Array = _partials(0.14, [1420.0 * detune] as Array[float], [1.0] as Array[float], 0.030, 0.01)
	_add(out, settle, _db(-15.0), 0.210)

	_normalize(out, 0.94)
	return out


## Restrained copper, not a jingle: a fifth, a soft attack, and nothing rising.
func _reward_experience(_rng: RandomNumberGenerator, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var chord: PackedFloat32Array = _partials(seconds, [656.0, 984.0] as Array[float], [1.0, 0.55] as Array[float], 0.190, 0.005)
	_env_attack_decay(chord, 0.018, seconds - 0.018, 1.0)
	_add(out, chord, 1.0, 0.0)

	var body: PackedFloat32Array = _partials(seconds * 0.8, [328.0] as Array[float], [1.0] as Array[float], 0.120, 0.01)
	_add(out, body, _db(-12.0), 0.004)

	_normalize(out, 0.80)
	return out


## A stone slab sliding: low-passed noise with a swell, plus a quiet body. It is
## a surface, not a chime, and every menu surface in the prototype uses it.
func _stone_slab(
	rng: RandomNumberGenerator, seconds: float, body_hz: float, attack: float, decay: float
) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var slide: PackedFloat32Array = _noise(rng, seconds)
	_lowpass(slide, 900.0, 2)
	_env_attack_decay(slide, attack, decay, 1.3)
	_peak_to(slide, 1.0)
	_add(out, slide, 1.0, 0.0)

	var body: PackedFloat32Array = _partials(seconds * 0.7, [body_hz] as Array[float], [1.0] as Array[float], decay * 0.55, 0.02)
	_add(out, body, _db(-11.0), attack * 0.5)

	_normalize(out, 0.86)
	return out


## The slab closing: the open cue with its envelope reversed, so the swell
## becomes a settle.
func _menu_close(rng: RandomNumberGenerator, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _stone_slab(rng, seconds, 300.0, 0.030, 0.110)
	_reverse(out)
	_normalize(out, 0.84)
	return out


## Leather and iron: a strap creak, a firm click as the grip is taken, and a low
## settle as the weight moves onto the arm.
func _equip(rng: RandomNumberGenerator, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var creak: PackedFloat32Array = _noise(rng, 0.26)
	_bandpass(creak, 700.0, 5.0, 2)
	_env_attack_decay(creak, 0.070, 0.170, 1.2)
	_peak_to(creak, 1.0)
	_add(out, creak, _db(-6.0), 0.0)

	var click: PackedFloat32Array = _partials(0.10, [1600.0, 2400.0] as Array[float], [1.0, 0.5] as Array[float], 0.030, 0.01)
	_add(out, click, 1.0, 0.090)

	var settle: PackedFloat32Array = _partials(0.26, [110.0] as Array[float], [1.0] as Array[float], 0.090, 0.03)
	_add(out, settle, _db(-5.0), 0.095)

	_normalize(out, 0.92)
	return out


## The one Rift-flavoured cue: a short suction, then a reversed-onset swell into
## a low copper triad. No riser, no whoosh-up, no impact.
func _passive_confirm(rng: RandomNumberGenerator, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)

	var suction: PackedFloat32Array = _noise(rng, 0.140)
	_bandpass_swept(suction, 900.0, 180.0, 3.0, 2)
	_env_attack_decay(suction, 0.010, 0.130, 1.4)
	_peak_to(suction, 1.0)
	_add(out, suction, _db(-8.0), 0.0)

	var swell: PackedFloat32Array = _partials(0.22, [392.0] as Array[float], [1.0] as Array[float], 0.090, 0.0)
	_reverse(swell)
	_add(out, swell, _db(-11.0), 0.120)

	var triad: PackedFloat32Array = _partials(0.46, [196.0, 294.0, 392.0] as Array[float], [1.0, 0.62, 0.40] as Array[float], 0.320, 0.004)
	_env_attack_decay(triad, 0.026, 0.430, 1.0)
	_add(out, triad, 1.0, 0.240)

	_normalize(out, 0.88)
	return out


## A very quiet stone tick, near the threshold of notice.
func _menu_move(rng: RandomNumberGenerator, variant: int, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var tick: PackedFloat32Array = _noise(rng, seconds)
	_bandpass(tick, 1300.0 + 180.0 * float(variant), 6.0, 2)
	_exp_decay(tick, 0.012)
	_peak_to(tick, 1.0)
	_add(out, tick, 1.0, 0.0)
	_normalize(out, 0.70)
	return out


## A small iron tick. It confirms; it does not celebrate.
func _menu_confirm(rng: RandomNumberGenerator, variant: int, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var transient: PackedFloat32Array = _noise(rng, 0.010)
	_highpass(transient, 1800.0)
	_exp_decay(transient, 0.003)
	_peak_to(transient, 1.0)
	_add(out, transient, _db(-8.0), 0.0)

	var detune: float = 1.0 + 0.022 * float(variant)
	var iron: PackedFloat32Array = _partials(
		0.11, [1420.0 * detune, 2130.0 * detune] as Array[float], [1.0, 0.55] as Array[float], 0.045, 0.01
	)
	_add(out, iron, 1.0, 0.001)

	_normalize(out, 0.82)
	return out


## A dull dead thud. Deliberately not an error buzzer: nothing tonal, nothing
## rising, nothing that sounds like a machine complaining.
func _invalid_action(rng: RandomNumberGenerator, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)
	var thud: PackedFloat32Array = _noise(rng, seconds)
	_lowpass(thud, 320.0, 2)
	_env_attack_decay(thud, 0.004, 0.120, 1.5)
	_peak_to(thud, 1.0)
	_add(out, thud, 1.0, 0.0)

	var damped_freqs: Array[float] = [152.0]
	var damped_amps: Array[float] = [1.0]
	var damped: PackedFloat32Array = _partials(0.16, damped_freqs, damped_amps, 0.045, 0.06)
	_add(out, damped, _db(-4.0), 0.001)

	_normalize(out, 0.80)
	return out


## Fallen: suction, a hollow drone, one distant fracture, then authored silence.
func _fallen(rng: RandomNumberGenerator, seconds: float) -> PackedFloat32Array:
	var out: PackedFloat32Array = _silence(seconds)

	var suction: PackedFloat32Array = _noise(rng, 0.560)
	_bandpass_swept(suction, 820.0, 90.0, 2.6, 2)
	_env_attack_decay(suction, 0.020, 0.520, 1.3)
	_peak_to(suction, 1.0)
	_add(out, suction, _db(-3.0), 0.0)

	var drone: PackedFloat32Array = _partials(1.25, [55.0, 82.5] as Array[float], [1.0, 0.32] as Array[float], 0.900, 0.01)
	_env_attack_decay(drone, 0.060, 1.170, 1.0)
	_add(out, drone, 1.0, 0.030)

	var distant: PackedFloat32Array = _noise(rng, 0.060)
	_bandpass(distant, 1650.0, 8.0, 2)
	_exp_decay(distant, 0.016)
	_peak_to(distant, 1.0)
	_add(out, distant, _db(-17.0), 0.340)

	# CONTROLLED SILENCE. Everything above is fully down by 1.25 s; the remaining
	# 350 ms is authored quiet, which the canon names as part of the palette.
	_normalize(out, 0.90)
	var silence_from: int = int(1.25 * RATE)
	for i: int in range(silence_from, out.size()):
		var fade: float = clampf(1.0 - float(i - silence_from) / (0.05 * RATE), 0.0, 1.0)
		out[i] *= fade
	return out


# =============================================================================
#  Synthesis primitives
# =============================================================================

func _silence(seconds: float) -> PackedFloat32Array:
	var buffer: PackedFloat32Array = PackedFloat32Array()
	buffer.resize(maxi(int(seconds * RATE), 1))
	buffer.fill(0.0)
	return buffer


func _noise(rng: RandomNumberGenerator, seconds: float) -> PackedFloat32Array:
	var buffer: PackedFloat32Array = _silence(seconds)
	for i: int in buffer.size():
		buffer[i] = rng.randf_range(-1.0, 1.0)
	return buffer


## A cluster of decaying sine partials with an optional downward pitch droop,
## expressed as the fraction of the starting frequency lost across the buffer.
func _partials(
	seconds: float, freqs: Array[float], amps: Array[float], tau: float, droop: float
) -> PackedFloat32Array:
	var buffer: PackedFloat32Array = _silence(seconds)
	var count: int = buffer.size()
	for index: int in freqs.size():
		var frequency: float = freqs[index]
		var amplitude: float = amps[index] if index < amps.size() else 1.0
		var phase: float = 0.0
		for i: int in count:
			var progress: float = float(i) / float(count)
			var live: float = frequency * (1.0 - droop * progress)
			phase += TAU_2PI * live / RATE
			buffer[i] += sin(phase) * amplitude * exp(-float(i) / (tau * RATE))
	return buffer


## A sine sweeping linearly from `from_hz` to `to_hz`, used for pitch strain.
func _swept_sine(seconds: float, from_hz: float, to_hz: float, _q: float) -> PackedFloat32Array:
	var buffer: PackedFloat32Array = _silence(seconds)
	var count: int = buffer.size()
	var phase: float = 0.0
	for i: int in count:
		var live: float = lerpf(from_hz, to_hz, float(i) / float(count))
		phase += TAU_2PI * live / RATE
		buffer[i] = sin(phase)
	return buffer


## One-pole low-pass, applied in place. `passes` steepens the skirt as above.
func _lowpass(buffer: PackedFloat32Array, cutoff: float, passes: int = 1) -> void:
	var alpha: float = clampf(1.0 - exp(-TAU_2PI * cutoff / RATE), 0.0, 1.0)
	for _pass: int in maxi(passes, 1):
		var state: float = 0.0
		for i: int in buffer.size():
			state += alpha * (buffer[i] - state)
			buffer[i] = state


## One-pole high-pass, applied in place.
func _highpass(buffer: PackedFloat32Array, cutoff: float) -> void:
	var alpha: float = clampf(1.0 - exp(-TAU_2PI * cutoff / RATE), 0.0, 1.0)
	var state: float = 0.0
	for i: int in buffer.size():
		state += alpha * (buffer[i] - state)
		buffer[i] = buffer[i] - state


## Chamberlin state-variable band-pass at a fixed centre, applied in place.
##
## `passes` runs the same filter again over its own output. One pass has only
## 6 dB/octave skirts, which leaves so much energy outside the band that white
## noise still reads as hiss rather than as a resonant body; two passes make the
## band audible as a MATERIAL. Every cue that has to sound like a thing rather
## than like noise uses two.
func _bandpass(buffer: PackedFloat32Array, centre: float, q: float, passes: int = 1) -> void:
	var f: float = 2.0 * sin(PI * clampf(centre, 20.0, RATE * 0.20) / RATE)
	var damping: float = 1.0 / maxf(q, 0.5)
	for _pass: int in maxi(passes, 1):
		var low: float = 0.0
		var band: float = 0.0
		for i: int in buffer.size():
			low += f * band
			var high: float = buffer[i] - low - damping * band
			band += f * high
			buffer[i] = band


## The same filter with its centre swept from `from_hz` to `to_hz` across the
## buffer. This is what makes a swing read as a moving object rather than as a
## static hiss.
func _bandpass_swept(
	buffer: PackedFloat32Array, from_hz: float, to_hz: float, q: float, passes: int = 1
) -> void:
	var damping: float = 1.0 / maxf(q, 0.5)
	var count: int = maxi(buffer.size(), 1)
	for _pass: int in maxi(passes, 1):
		var low: float = 0.0
		var band: float = 0.0
		for i: int in buffer.size():
			var centre: float = lerpf(from_hz, to_hz, float(i) / float(count))
			var f: float = 2.0 * sin(PI * clampf(centre, 20.0, RATE * 0.20) / RATE)
			low += f * band
			var high: float = buffer[i] - low - damping * band
			band += f * high
			buffer[i] = band


## Exponential decay with time constant `tau`, applied in place.
func _exp_decay(buffer: PackedFloat32Array, tau: float) -> void:
	var samples: float = maxf(tau * RATE, 1.0)
	for i: int in buffer.size():
		buffer[i] *= exp(-float(i) / samples)


## Attack then decay, with `curve` shaping the decay (1.0 linear-in-exponent).
func _env_attack_decay(
	buffer: PackedFloat32Array, attack: float, decay: float, curve: float
) -> void:
	var attack_samples: float = maxf(attack * RATE, 1.0)
	var decay_samples: float = maxf(decay * RATE, 1.0)
	for i: int in buffer.size():
		var value: float = float(i)
		var gain: float = 0.0
		if value < attack_samples:
			gain = value / attack_samples
		else:
			gain = exp(-pow((value - attack_samples) / decay_samples, curve))
		buffer[i] *= gain


func _reverse(buffer: PackedFloat32Array) -> void:
	var count: int = buffer.size()
	for i: int in count / 2:
		var swap: float = buffer[i]
		buffer[i] = buffer[count - 1 - i]
		buffer[count - 1 - i] = swap


## Mixes `layer` into `into` at `at_seconds`, scaled by `gain`.
func _add(
	into: PackedFloat32Array, layer: PackedFloat32Array, gain: float, at_seconds: float
) -> void:
	var offset: int = maxi(int(at_seconds * RATE), 0)
	for i: int in layer.size():
		var index: int = offset + i
		if index >= into.size():
			return
		into[index] += layer[i] * gain


## Scales a LAYER to a known peak before it is mixed.
##
## Filters change level by a large and unobvious amount — a one-pole low-pass at
## 170 Hz over white noise loses about 30 dB — so mixing raw filter output at a
## nominal gain means the balance between layers is set by the filter's response
## rather than by the recipe. Every layered cue peaks each layer first and then
## applies its intended gain, so the numbers in the recipe are the numbers you
## hear.
func _peak_to(buffer: PackedFloat32Array, target: float) -> void:
	var loudest: float = 0.0
	for value: float in buffer:
		loudest = maxf(loudest, absf(value))
	if loudest <= 0.000001:
		return
	var scale: float = target / loudest
	for i: int in buffer.size():
		buffer[i] *= scale


func _normalize(buffer: PackedFloat32Array, peak: float) -> void:
	var loudest: float = 0.0
	for value: float in buffer:
		loudest = maxf(loudest, absf(value))
	if loudest <= 0.00001:
		return
	var scale: float = peak / loudest
	for i: int in buffer.size():
		# A gentle soft clip that leaves the body of the cue untouched and only
		# ROUNDS the extremes, so a stacked transient cannot square off while the
		# authored crest factor survives.
		var value: float = buffer[i] * scale
		var magnitude: float = absf(value)
		if magnitude > 0.70:
			magnitude = 0.70 + 0.30 * tanh((magnitude - 0.70) / 0.30)
			value = signf(value) * magnitude
		buffer[i] = value


## Removes the two clicks that any generated buffer otherwise has: one at sample
## zero and one at the end.
func _fade_edges(buffer: PackedFloat32Array, in_seconds: float, out_seconds: float) -> void:
	var head: int = maxi(int(in_seconds * RATE), 1)
	var tail: int = maxi(int(out_seconds * RATE), 1)
	for i: int in mini(head, buffer.size()):
		buffer[i] *= float(i) / float(head)
	for i: int in mini(tail, buffer.size()):
		var index: int = buffer.size() - 1 - i
		buffer[index] *= float(i) / float(tail)


func _db(decibels: float) -> float:
	return db_to_linear(decibels)


# =============================================================================
#  Output
# =============================================================================

func _to_stream(samples: PackedFloat32Array) -> AudioStreamWAV:
	var bytes: PackedByteArray = PackedByteArray()
	bytes.resize(samples.size() * 2)
	for i: int in samples.size():
		var value: int = clampi(int(round(clampf(samples[i], -1.0, 1.0) * 32767.0)), -32768, 32767)
		bytes.encode_s16(i * 2, value)
	var stream: AudioStreamWAV = AudioStreamWAV.new()
	stream.format = AudioStreamWAV.FORMAT_16_BITS
	stream.mix_rate = PrototypeCueCatalogue.MIX_RATE
	stream.stereo = false
	stream.loop_mode = AudioStreamWAV.LOOP_DISABLED
	stream.data = bytes
	return stream


## Writes a plain RIFF/WAVE audition copy outside the project. This exists so the
## cues can be listened to on ordinary speakers and headphones before the build
## is launched; nothing in the game reads it.
func _write_wav_audition(stream: AudioStreamWAV, path: String) -> void:
	var pcm: PackedByteArray = stream.data
	var header: PackedByteArray = PackedByteArray()
	header.append_array("RIFF".to_ascii_buffer())
	header.append_array(_le32(36 + pcm.size()))
	header.append_array("WAVEfmt ".to_ascii_buffer())
	header.append_array(_le32(16))            # PCM chunk size
	header.append_array(_le16(1))             # format: PCM
	header.append_array(_le16(1))             # channels: mono
	header.append_array(_le32(PrototypeCueCatalogue.MIX_RATE))
	header.append_array(_le32(PrototypeCueCatalogue.MIX_RATE * 2))
	header.append_array(_le16(2))             # block align
	header.append_array(_le16(16))            # bits per sample
	header.append_array("data".to_ascii_buffer())
	header.append_array(_le32(pcm.size()))
	var file: FileAccess = FileAccess.open(path, FileAccess.WRITE)
	if file == null:
		printerr("FAIL: could not write audition copy %s" % path)
		return
	file.store_buffer(header)
	file.store_buffer(pcm)
	file.close()


func _le16(value: int) -> PackedByteArray:
	var bytes: PackedByteArray = PackedByteArray()
	bytes.resize(2)
	bytes.encode_u16(0, value)
	return bytes


func _le32(value: int) -> PackedByteArray:
	var bytes: PackedByteArray = PackedByteArray()
	bytes.resize(4)
	bytes.encode_u32(0, value)
	return bytes


func _measure(samples: PackedFloat32Array) -> Dictionary:
	var peak: float = 0.0
	var sum_squares: float = 0.0
	for value: float in samples:
		peak = maxf(peak, absf(value))
		sum_squares += value * value
	var rms: float = sqrt(sum_squares / maxf(float(samples.size()), 1.0))
	return {
		"peak": peak,
		"rms": rms,
		"crest_db": linear_to_db(peak / maxf(rms, 0.000001)),
	}


func _print_summary(written: int, bytes: int) -> void:
	for family: String in PrototypeCueCatalogue.family_names():
		var entry: Dictionary = PrototypeCueCatalogue.FAMILIES[family] as Dictionary
		print("  %-26s %d variant%s  %5.2f s  %-6s %+6.1f dB  jitter +/-%.0f%%" % [
			family, int(entry["variants"]), "" if int(entry["variants"]) == 1 else "s",
			float(entry["seconds"]), String(entry["bus"]), float(entry["gain_db"]),
			float(entry["pitch_jitter"]) * 100.0,
		])
	print("")
	print("  %d variants, %d families, %.1f KiB of 16-bit %d Hz mono PCM" % [
		written, PrototypeCueCatalogue.FAMILIES.size(), float(bytes) / 1024.0,
		PrototypeCueCatalogue.MIX_RATE,
	])


func _print_peaks() -> void:
	print("")
	print("  measured, per variant:")
	print("  %-26s %-3s %7s %7s %7s %8s" % ["family", "#", "length", "peak", "rms", "crest"])
	for row: Dictionary in _rows:
		print("  %-26s %-3d %6.3fs %7.4f %7.4f %6.1f dB" % [
			String(row["family"]), int(row["variant"]), float(row["seconds"]),
			float(row["peak"]), float(row["rms"]), float(row["crest_db"]),
		])


## Writes the derivation note beside the cues, from the SAME catalogue the
## synthesis read, so the published record cannot drift from the code.
func _write_derivation_note() -> int:
	var lines: PackedStringArray = PackedStringArray()
	lines.append("# Riftwrought — Prototype Zero authored audio: source and derivation")
	lines.append("")
	lines.append("**Generated file. Do not hand-edit.** Rebuild with:")
	lines.append("")
	lines.append("```bash")
	lines.append("/Applications/Godot.app/Contents/MacOS/Godot --headless --path game \\")
	lines.append("  --script res://scripts/tools/build_prototype_audio.gd")
	lines.append("```")
	lines.append("")
	lines.append("## Source")
	lines.append("")
	lines.append("**Every cue in this folder is original project-authored content, synthesised")
	lines.append("by `game/scripts/tools/build_prototype_audio.gd` from the recipes in")
	lines.append("`game/scripts/audio/prototype_cue_catalogue.gd`.**")
	lines.append("")
	lines.append("- **Creator:** the Riftwrought project (procedural synthesis, no recording)")
	lines.append("- **Third-party content:** none. No sample, loop, library, recording, or")
	lines.append("  marketplace asset was downloaded, purchased, extracted, or imported.")
	lines.append("- **Licence:** project-owned. Commercial use, modification, and redistribution")
	lines.append("  inside a compiled game are unrestricted because no external rights exist.")
	lines.append("- **Attribution:** none required.")
	lines.append("- **Status:** *prototype placeholder*. These cues exist so Prototype Zero's")
	lines.append("  combat feel can be judged (specification §19, decision D-189). They are not")
	lines.append("  shipping-approved audio and no first-MVP cue is promised by them.")
	lines.append("- **Format:** 16-bit %d Hz mono PCM inside Godot `AudioStreamWAV` resources." % PrototypeCueCatalogue.MIX_RATE)
	lines.append("  Saved as `.res`, so there is no import step and no `.wav`, `.ogg`, or `.mp3`")
	lines.append("  file anywhere under `assets/prototype/audio`. The Gate F suite walks this")
	lines.append("  directory and asserts that.")
	lines.append("- **Determinism:** each variant seeds its own generator from its family name")
	lines.append("  and index, so regenerating produces byte-identical files.")
	lines.append("")
	lines.append("## Music")
	lines.append("")
	lines.append("Absent, deliberately. Specification §19: *\"Music is absent unless a later")
	lines.append("registered source is approved. Silence is preferable to unlicensed placeholder")
	lines.append("music.\"* No music stream, loop, or bed exists in this project.")
	lines.append("")
	lines.append("## Cue families")
	lines.append("")
	lines.append("| Family | Variants | Length | Bus | Gain | Pitch jitter | Min interval |")
	lines.append("|---|---:|---:|---|---:|---:|---:|")
	for family: String in PrototypeCueCatalogue.family_names():
		var entry: Dictionary = PrototypeCueCatalogue.FAMILIES[family] as Dictionary
		lines.append("| `%s` | %d | %.2f s | %s | %+.1f dB | ±%.0f%% | %.2f s |" % [
			family, int(entry["variants"]), float(entry["seconds"]), String(entry["bus"]),
			float(entry["gain_db"]), float(entry["pitch_jitter"]) * 100.0,
			float(entry["min_interval"]),
		])
	lines.append("")
	lines.append("## Derivation, cue by cue")
	lines.append("")
	for family: String in PrototypeCueCatalogue.family_names():
		var entry: Dictionary = PrototypeCueCatalogue.FAMILIES[family] as Dictionary
		lines.append("### `%s`" % family)
		lines.append("")
		lines.append(String(entry["recipe"]))
		lines.append("")
		var measured: PackedStringArray = PackedStringArray()
		for row: Dictionary in _rows:
			if String(row["family"]) != family:
				continue
			measured.append("take %d — %.3f s, peak %.3f, RMS %.3f, crest %.1f dB" % [
				int(row["variant"]), float(row["seconds"]), float(row["peak"]),
				float(row["rms"]), float(row["crest_db"]),
			])
		for line: String in measured:
			lines.append("- %s" % line)
		lines.append("")

	var file: FileAccess = FileAccess.open(PrototypeCueCatalogue.DERIVATION_NOTE, FileAccess.WRITE)
	if file == null:
		printerr("FAIL: could not write %s" % PrototypeCueCatalogue.DERIVATION_NOTE)
		return 1
	file.store_string("\n".join(lines) + "\n")
	file.close()
	print("  wrote %s" % PrototypeCueCatalogue.DERIVATION_NOTE)
	return 0
