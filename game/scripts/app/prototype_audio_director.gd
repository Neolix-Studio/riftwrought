class_name PrototypeAudioDirector
extends Node
## Prototype Zero — Gate F: the named audio cue router (specification §19,
## decision D-189).
##
## Specification §19 sets the order of work, and this is step 1 and step 4 of it:
##
##   1. build named audio cue slots and event timing
##   2. use project-authored temporary procedural tones/noise only for plumbing
##   3. do not download or ship an unregistered "free" sound
##   4. register any selected CC0 or permissive commercial source before importing
##   5. do not declare the combat-feel exit gate passed while prominent cues are
##      only diagnostic beeps
##
## Every cue this director can play is a project-authored, layered, shaped cue
## generated by `scripts/tools/build_prototype_audio.gd` from the recipes in
## `scripts/audio/prototype_cue_catalogue.gd`. Nothing was downloaded, and the
## Gate F suite walks `assets/prototype/audio` to prove no `.wav`, `.ogg`, or
## `.mp3` file exists there at all. Whether the result is good enough to judge
## combat feel is the project owner's call, not this file's claim.
##
## WHAT THIS FILE ACTUALLY OWNS
##
##   ROUTING          cue name -> bus, base gain, and one of the existing
##                    Master / Combat / UI buses from the Gate A layout. No bus
##                    was added.
##   VARIATION        specification §19: "Prevent identical-sample machine-gun
##                    repetition through legal pitch, level, and source
##                    variation." All three are here — a shuffle bag over the
##                    authored takes so a variant cannot immediately repeat
##                    itself, plus per-play pitch and level jitter.
##   RATE LIMITING    each family declares the shortest gap between two of its
##                    own plays. A request inside that gap is DROPPED and
##                    counted, so an eight-attacks-per-second future build
##                    cannot turn one cue into a buzz.
##   MASTER VOLUME    specification §19: "Master volume applies immediately."
##                    One `AudioServer` write, on the frame the slider moves.
##
## It runs with `PROCESS_MODE_ALWAYS`, so a Hit that has already started is not
## chopped off when a modal pauses the world, and so the Master-volume slider in
## a paused settings panel is audible while you drag it.
##
## MUSIC IS ABSENT and there is no music path here at all. Specification §19:
## "Silence is preferable to unlicensed placeholder music."

## Voices per bus. Prototype Zero's densest moment is three Graveblades, so this
## is generous rather than tuned; a request with no free voice steals the oldest.
const COMBAT_VOICES: int = 12
const UI_VOICES: int = 6

const MASTER_BUS: String = "Master"

var master_volume: float = 0.8

# --- Instrumentation (specification §22) -------------------------------------
var cues_played: int = 0
var cues_dropped: int = 0
var last_cue: String = "none"
var last_variant: int = 0
var last_cue_at_msec: int = 0
var missing_streams: PackedStringArray = PackedStringArray()
## Per family: how many times it has played this session.
var play_counts: Dictionary = {}
## Per family: which variants have been played, in order. Bounded; the Gate F
## suite reads it to prove the shuffle bag really cycles.
var variant_history: Dictionary = {}

var _streams: Dictionary = {}          ## family -> Array[AudioStream]
var _bags: Dictionary = {}             ## family -> Array[int], the shuffle bag
var _last_played_msec: Dictionary = {} ## family -> int
var _last_variant: Dictionary = {}     ## family -> int
var _voices: Dictionary = {}           ## bus name -> Array[AudioStreamPlayer]
var _rng: RandomNumberGenerator = RandomNumberGenerator.new()
var _log: Callable = Callable()

signal cue_played(family: String, variant: int)


func _ready() -> void:
	# The world pauses constantly in Prototype Zero — every modal sets
	# `get_tree().paused`. A cue that has already begun must not be cut in half by
	# that, and the Master slider has to be audible while the panel holding it is
	# the reason the world is stopped.
	process_mode = Node.PROCESS_MODE_ALWAYS
	_rng.seed = 0x51F7C0DE
	_build_voices(PrototypeCueCatalogue.BUS_COMBAT, COMBAT_VOICES)
	_build_voices(PrototypeCueCatalogue.BUS_UI, UI_VOICES)
	_load_catalogue()
	apply_master_volume(master_volume)


func set_log_sink(sink: Callable) -> void:
	_log = sink


func _build_voices(bus: String, count: int) -> void:
	var pool: Array[AudioStreamPlayer] = []
	for index: int in count:
		var voice: AudioStreamPlayer = AudioStreamPlayer.new()
		voice.name = "%sVoice%d" % [bus, index + 1]
		voice.bus = bus
		voice.process_mode = Node.PROCESS_MODE_ALWAYS
		add_child(voice)
		pool.append(voice)
	_voices[bus] = pool


## Loads every variant the catalogue declares. A missing file is RECORDED rather
## than crashing, so a project that has not run the generator yet still boots and
## says exactly which cue is absent.
func _load_catalogue() -> void:
	for family: String in PrototypeCueCatalogue.family_names():
		var variants: Array[AudioStream] = []
		for index: int in PrototypeCueCatalogue.variant_count(family):
			var path: String = PrototypeCueCatalogue.variant_path(family, index)
			if not ResourceLoader.exists(path):
				missing_streams.append(path)
				continue
			var stream: AudioStream = load(path) as AudioStream
			if stream == null:
				missing_streams.append(path)
				continue
			variants.append(stream)
		_streams[family] = variants
		_bags[family] = PackedInt32Array()
		play_counts[family] = 0
		variant_history[family] = PackedInt32Array()
		_last_played_msec[family] = -100000
		_last_variant[family] = -1
	if not missing_streams.is_empty():
		push_warning("PrototypeAudioDirector: %d cue variants are missing; run build_prototype_audio.gd" % missing_streams.size())


func is_complete() -> bool:
	return missing_streams.is_empty() and loaded_variant_count() == PrototypeCueCatalogue.total_variants()


func loaded_variant_count() -> int:
	var total: int = 0
	for family: String in _streams:
		total += (_streams[family] as Array[AudioStream]).size()
	return total


# --- Playing -----------------------------------------------------------------

## Plays one cue family. Returns the variant index played, or -1 when the cue was
## dropped by its own rate limit or has no authored take.
func play(requested: String) -> int:
	# Alias resolution first, so a surface that names itself (`pause_open`) and a
	# surface that names the sound (`menu_open`) reach the same authored cue.
	var family: String = PrototypeCueCatalogue.resolve(requested)
	if not PrototypeCueCatalogue.FAMILIES.has(family):
		# A misspelled cue name is a bug, not a silent no-op.
		push_warning("PrototypeAudioDirector: unknown cue family '%s'" % requested)
		return -1
	var variants: Array[AudioStream] = _streams.get(family, [] as Array[AudioStream])
	if variants.is_empty():
		cues_dropped += 1
		return -1

	# Rate limit, measured in WALL-CLOCK time on purpose: it exists to stop the
	# ear being machine-gunned, and an ear does not pause when the simulation
	# does. Every mechanical window in this project uses simulation time; this
	# one deliberately does not, and that is the difference between a feel guard
	# and a game rule.
	var now: int = Time.get_ticks_msec()
	var minimum: float = float(PrototypeCueCatalogue.field(family, "min_interval", 0.0))
	if float(now - int(_last_played_msec[family])) / 1000.0 < minimum:
		cues_dropped += 1
		return -1

	var variant: int = _next_variant(family, variants.size())
	var voice: AudioStreamPlayer = _claim_voice(String(PrototypeCueCatalogue.field(family, "bus", PrototypeCueCatalogue.BUS_UI)))
	if voice == null:
		cues_dropped += 1
		return -1

	var pitch_jitter: float = float(PrototypeCueCatalogue.field(family, "pitch_jitter", 0.0))
	var gain_jitter: float = float(PrototypeCueCatalogue.field(family, "gain_jitter_db", 0.0))
	voice.stream = variants[variant]
	voice.pitch_scale = 1.0 + _rng.randf_range(-pitch_jitter, pitch_jitter)
	voice.volume_db = float(PrototypeCueCatalogue.field(family, "gain_db", 0.0)) + _rng.randf_range(-gain_jitter, gain_jitter)
	voice.play()

	_last_played_msec[family] = now
	_last_variant[family] = variant
	play_counts[family] = int(play_counts[family]) + 1
	var history: PackedInt32Array = variant_history[family]
	history.append(variant)
	if history.size() > 32:
		history.remove_at(0)
	variant_history[family] = history

	cues_played += 1
	last_cue = family
	last_variant = variant
	last_cue_at_msec = now
	cue_played.emit(family, variant)
	return variant


## Shuffle bag. Every authored take is played once before any is played again,
## and a refilled bag never begins with the take that just finished — which is
## the one repetition an ear notices.
func _next_variant(family: String, count: int) -> int:
	if count <= 1:
		return 0
	var bag: PackedInt32Array = _bags[family]
	if bag.is_empty():
		var order: Array[int] = []
		for index: int in count:
			order.append(index)
		# Deterministic Fisher-Yates from this director's own generator.
		for i: int in range(order.size() - 1, 0, -1):
			var j: int = _rng.randi_range(0, i)
			var swap: int = order[i]
			order[i] = order[j]
			order[j] = swap
		if order[0] == int(_last_variant[family]) and order.size() > 1:
			var swap_first: int = order[0]
			order[0] = order[1]
			order[1] = swap_first
		bag = PackedInt32Array(order)
	var chosen: int = bag[0]
	bag.remove_at(0)
	_bags[family] = bag
	return chosen


## The first idle voice on the bus, or the oldest busy one. Stealing is better
## than dropping for a Hit; the rate limit above is what actually protects the
## ear, and it has already run.
func _claim_voice(bus: String) -> AudioStreamPlayer:
	var pool: Array[AudioStreamPlayer] = _voices.get(bus, [] as Array[AudioStreamPlayer])
	if pool.is_empty():
		return null
	for voice: AudioStreamPlayer in pool:
		if not voice.playing:
			return voice
	var oldest: AudioStreamPlayer = pool[0]
	var furthest: float = -1.0
	for voice: AudioStreamPlayer in pool:
		var position: float = voice.get_playback_position()
		if position > furthest:
			furthest = position
			oldest = voice
	return oldest


func stop_all() -> void:
	for bus: String in _voices:
		for voice: AudioStreamPlayer in (_voices[bus] as Array[AudioStreamPlayer]):
			voice.stop()


func active_voices() -> int:
	var total: int = 0
	for bus: String in _voices:
		for voice: AudioStreamPlayer in (_voices[bus] as Array[AudioStreamPlayer]):
			if voice.playing:
				total += 1
	return total


func voice_count() -> int:
	var total: int = 0
	for bus: String in _voices:
		total += (_voices[bus] as Array[AudioStreamPlayer]).size()
	return total


# --- Master volume -----------------------------------------------------------

## Specification §19 and §21: one Master volume, applied IMMEDIATELY. Zero mutes
## the bus outright rather than setting an inaudible-but-finite decibel value, so
## "Off" is genuinely off.
func apply_master_volume(value: float) -> void:
	master_volume = clampf(value, 0.0, 1.0)
	var bus: int = AudioServer.get_bus_index(MASTER_BUS)
	if bus < 0:
		return
	AudioServer.set_bus_mute(bus, master_volume <= 0.0001)
	# A perceptual curve: linear sliders sound wrong above about a third of the
	# way up. `linear_to_db` of the raw value is the same curve Godot's own mixer
	# uses internally.
	AudioServer.set_bus_volume_db(bus, linear_to_db(maxf(master_volume, 0.0001)))


func master_volume_db() -> float:
	var bus: int = AudioServer.get_bus_index(MASTER_BUS)
	if bus < 0:
		return 0.0
	return AudioServer.get_bus_volume_db(bus)


func master_is_muted() -> bool:
	var bus: int = AudioServer.get_bus_index(MASTER_BUS)
	return bus >= 0 and AudioServer.is_bus_mute(bus)


# --- Instrumentation ---------------------------------------------------------

func describe() -> String:
	return "%d cues played, %d dropped by rate limit, last '%s' take %d, %d/%d voices, master %.0f%%" % [
		cues_played, cues_dropped, last_cue, last_variant + 1,
		active_voices(), voice_count(), master_volume * 100.0,
	]


func _emit(event: String, detail: String) -> void:
	if _log.is_valid():
		_log.call(event, detail)
